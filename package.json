{
  "name": "dsh-mera-theme",
  "version": "1.4.5",
  "private": true,
  "type": "module",
  "description": "MERA (Mermaid.js gijinka) theme for DeepSeek Harness: raspberry rose #FF3670 x pearl white x ink navy #111827, with sunny-day / rainy-night wallpapers.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
